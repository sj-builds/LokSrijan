# LokSrijan Backend - Environment Template
#
# Copy this file to backend/.env
# Never commit real credentials.

# APPLICATION

APP_NAME=loksrijan-api
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api


# DATABASE

DATABASE_URL=postgresql+psycopg://loksrijan:loksrijan@localhost:5432/loksrijan


# CORS

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# AUTHENTICATION

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# AI CONFIGURATION

# Supported values for this MVP:
# mock
# gemini

AI_PROVIDER=mock
AI_API_KEY=

AI_TEXT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001

AI_CONFIDENCE_THRESHOLD=0.70
SIMILARITY_THRESHOLD=0.80