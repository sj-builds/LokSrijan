# ─────────────────────────────────────────────────────────────
# LokSrijan backend — environment template
#
# Copy this file to `backend/.env` and adjust for your machine.
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED NOW ─────────────────────────────────────────────

# PostgreSQL connection (SQLAlchemy URL, psycopg v3 driver).
# Matches the credentials in the repository-root docker-compose.yml.
DATABASE_URL=postgresql+psycopg://loksrijan:loksrijan@localhost:5432/loksrijan

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── OPTIONAL NOW (sensible defaults exist in app/core/config.py) ──

APP_NAME=loksrijan-api
ENVIRONMENT=development
DEBUG=true

# ── AUTHENTICATION ───────────────────────────────────────────

# JWT signing secret.
# IMPORTANT: Change this to a long random value in your real backend/.env.
JWT_SECRET_KEY=change-this-to-a-long-random-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── RESERVED FOR FUTURE USE — leave empty ────────────────────
# The AI layer is not implemented yet. These are placeholders so the
# variable names are agreed on now and nothing has to be renamed later.
# LokSrijan stays provider-agnostic: the provider is chosen by config,
# never hardcoded.

# Which provider the AIService should use. Use "mock" for local
# development — it returns fixed output and needs no key.
AI_PROVIDER=

# API key for the chosen provider. Keep this out of git, always.
AI_API_KEY=